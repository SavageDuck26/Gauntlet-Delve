scripts/bundle_strings.txt
scripts/bin_strings.txt

# ---- Game-derived exports / assets --------------------------------------
# NOT redistributed: extracted game content + derived data dumps (copyright +
# size). Only our own code, docs and the game LUA source are versioned here.
assets/
scripts/Exports/
scripts/crane_mod/
scripts/example_mod/
scripts/test_mod/
scripts/decoded_materials/
scripts/database_extractor/
